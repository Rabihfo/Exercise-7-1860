CHIP DecoderSegment201849171 {
    IN A, B, C, D;
    OUT d;

    PARTS:
    Not(in=A, out=nA);
    Not(in=B, out=nB);
    Not(in=C, out=nC);
    Not(in=D, out=nD);

    // Original working terms
    And(a=nA, b=nC, out=t1);
    And(a=t1, b=nD, out=term1);

    And(a=nA, b=C, out=t2);
    And(a=t2, b=D, out=term2);

    And(a=A, b=nB, out=t3);
    And(a=t3, b=C, out=term3);

    And(a=B, b=nC, out=t4);
    And(a=t4, b=D, out=term4);

    // NEW term for 0101 (hex 5): !A & B & !C & D
    And(a=nA, b=B, out=t5a);
    And(a=nC, b=D, out=t5b);
    And(a=t5a, b=t5b, out=term5);

    // Combine all
    Or(a=term1, b=term2, out=o1);
    Or(a=term3, b=term4, out=o2);
    Or(a=o1, b=o2, out=o3);
    Or(a=o3, b=term5, out=d);
}