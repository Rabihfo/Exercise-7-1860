CHIP DecoderSegment201849171 {
    IN A, B, C, D;
    OUT d;

    PARTS:
    // Inverters
    Not(in=A, out=nA);
    Not(in=B, out=nB);
    Not(in=C, out=nC);
    Not(in=D, out=nD);

    // Term 1: !A & !C & !D
    And(a=nA, b=nC, out=t1a);
    And(a=t1a, b=nD, out=term1);

    // Term 2: !A & C & D
    And(a=nA, b=C, out=t2a);
    And(a=t2a, b=D, out=term2);

    // Term 3: A & !B & C
    And(a=A, b=nB, out=t3a);
    And(a=t3a, b=C, out=term3);

    // Term 4: B & !C & D
    And(a=B, b=nC, out=t4a);
    And(a=t4a, b=D, out=term4);

    // OR terms together
    Or(a=term1, b=term2, out=o1);
    Or(a=term3, b=term4, out=o2);
    Or(a=o1, b=o2, out=d);
}