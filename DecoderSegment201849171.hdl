CHIP DecoderSegment201849171 {
    IN A, B, C, D;
    OUT d;

    PARTS:
    Not(in=A, out=nA);
    Not(in=B, out=nB);
    Not(in=C, out=nC);
    Not(in=D, out=nD);

    // Working terms
    And(a=nA, b=nC, out=t1);
    And(a=t1, b=nD, out=term1);  // hex 0

    And(a=nA, b=C, out=t2);
    And(a=t2, b=D, out=term2);  // hex 3

    And(a=nC, b=D, out=t3a);
    And(a=t3a, b=nA, out=term3);  // hex 2

    // NEW: hex 5: !A & B & !C & D
    And(a=nA, b=B, out=t4a);
    And(a=nC, b=D, out=t4b);
    And(a=t4a, b=t4b, out=term4);  // hex 5

    // Combine all
    Or(a=term1, b=term2, out=o1);
    Or(a=term3, b=term4, out=o2);
    Or(a=o1, b=o2, out=d);
}